{
	"name": "hiraku",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:api": "cd backend && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
		"dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
		"build": "vite build",
		"build:android": "vite build && npx cap sync android",
		"android:open": "npx cap open android",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22",
		"@vitest/coverage-v8": "^5.1.1",
		"concurrently": "^10.0.4",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.14.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@capacitor/android": "^8.6.2",
		"@capacitor/app": "^8.1.2",
		"@capacitor/cli": "^8.6.2",
		"@capacitor/core": "^8.6.2",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.7.1"
	}
}
